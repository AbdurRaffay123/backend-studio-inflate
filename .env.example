# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TRUST_PROXY=0          # Set to 1 when behind a reverse proxy (ngrok, nginx, ECS, etc.)

# Comma-separated browser origins allowed by CORS in production
# Leave blank in development to allow all origins
ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=info         # trace | debug | info | warn | error | fatal
# LOG_JSON=1           # enable structured pino HTTP access logs

# ─── Module flags (turn modules on/off) ──────────────────────────────────────
ENABLE_APPS_PRODUCT_OPTIONS=true
ENABLE_CRM=true

# ─── MongoDB (CRM) ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/inflate-studio-crm

# ─── JWT (CRM admin panel) ───────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h

# ─── CRM admin credentials ───────────────────────────────────────────────────
# Generate the hash once:  npm run generate:admin-hash <your-password>
ADMIN_EMAIL=nicholle@inflatestudio.com
ADMIN_PASSWORD_HASH=$2b$12$replace-with-output-of-generate-admin-hash-script

# ─── Shared API key (mobile app → public endpoints) ──────────────────────────
# Used by both modules for x-api-key auth on public routes
# Must match EXPO_PUBLIC_BACKEND_API_KEY and EXPO_PUBLIC_CRM_API_KEY in the mobile app
API_KEY=replace-with-a-secure-random-key

# ─── Product Options module ──────────────────────────────────────────────────
APP_SCRIPT_URL=https://assets.cloudlift.app/api/assets/options.js?shop=bzehub-jg.myshopify.com
POLL_INTERVAL_MS=30000
APP_DATA_FORMAT=auto   # auto | json | script
LOOKUP_RATE_LIMIT_MAX=60
UPLOAD_RATE_LIMIT_MAX=20

# Agent-only key for the diagnostic /test endpoint (header: x-agent-key)
# Fail-closed: if unset, the endpoint always returns 401
AGENT_API_KEY=

# Upload response URL mode: public (default) | presigned
UPLOAD_RESPONSE_URL_MODE=public
# S3_GET_PRESIGN_EXPIRES_SEC=3600
# S3_PUBLIC_BASE_URL=https://d111111abcdef8.cloudfront.net

# ─── AWS S3 (Product Options uploads) ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
